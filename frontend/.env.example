# HRMS Frontend Configuration

# Data Source: 'firebase' for Serverless (Netlify + Firebase) or 'rest' for Django REST API
VITE_DATA_SOURCE=firebase

# Firebase Configuration (Get from Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Django REST API Fallback URL (if using REST backend instead of Firebase)
VITE_API_URL=/api
